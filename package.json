{
  "name": "vibezcheck",
  "version": "0.5.9",
  "description": "The 1-line Token Metering & Cost Intelligence engine for LLMs. Track tokens, compute real-time dollar costs, protect agent loops, and stream financial telemetry with 0ms added latency.",
  "author": "VibezCheck <dev@vibezcheck.xyz> (https://vibezcheck.xyz)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seeyouin2x5x/vibezcheck-sdk.git"
  },
  "keywords": [
    "ai",
    "billing",
    "tokens",
    "metering",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "vercel-ai",
    "ai-sdk",
    "reasoning",
    "cost-calculator"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./meter": {
      "types": "./dist/meter/index.d.ts",
      "import": "./dist/meter/index.mjs",
      "require": "./dist/meter/index.js"
    },
    "./pricing": {
      "types": "./dist/pricing/index.d.ts",
      "import": "./dist/pricing/index.mjs",
      "require": "./dist/pricing/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "import": "./dist/ai-sdk/index.mjs",
      "require": "./dist/ai-sdk/index.js"
    },
    "./customers": {
      "types": "./dist/customers/index.d.ts",
      "import": "./dist/customers/index.mjs",
      "require": "./dist/customers/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.mjs",
      "require": "./dist/auth/index.js"
    },
    "./billing": {
      "types": "./dist/billing/index.d.ts",
      "import": "./dist/billing/index.mjs",
      "require": "./dist/billing/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    },
    "./ui": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    },
    "./database": {
      "types": "./dist/database/index.d.ts",
      "import": "./dist/database/index.mjs",
      "require": "./dist/database/index.js"
    },
    "./middleware": {
      "types": "./dist/ai-sdk/middleware.d.ts",
      "import": "./dist/ai-sdk/middleware.mjs",
      "require": "./dist/ai-sdk/middleware.js"
    }
  },
  "bin": {
    "vibezcheck": "bin/vibezcheck.js",
    "vibezcheck-examples": "bin/examples.js"
  },
  "files": [
    "dist",
    "bin",
    "examples",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "tsup"
  },
  "dependencies": {},
  "devDependencies": {
    "@ai-sdk/anthropic": "^2.0.35",
    "@ai-sdk/google": "^2.0.23",
    "@ai-sdk/openai": "^2.0.53",
    "@ai-sdk/provider": "^3.0.0",
    "@anthropic-ai/sdk": "^0.67.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ai": "^5.0.76",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "openai": "^6.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.5",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@ai-sdk/provider": ">=1.0.0",
    "@anthropic-ai/sdk": ">=0.30.0",
    "ai": ">=3.0.0",
    "openai": ">=4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/provider": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "homepage": "https://vibezcheck.xyz",
  "bugs": {
    "url": "https://github.com/seeyouin2x5x/vibezcheck-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
